# ============================================================
# Django Settings
# ============================================================
# Generate a secure key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Local development: True | Production: False
DEBUG=False

# Comma-separated allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,www.yourdomain.com

# ============================================================
# Email Configuration
# ============================================================
# Gmail SMTP settings
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here
# Note: Email recipients are fetched from subscriber database during sending

# ============================================================
# Security Settings (Production)
# ============================================================
# Redirect all HTTP to HTTPS
SECURE_SSL_REDIRECT=True

# Use secure cookies (only sent over HTTPS)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ============================================================
# SEO & Search Engine Verification
# ============================================================
# Steps to get verification codes:
# 1. Google Search Console: https://search.google.com/search-console
#    - Add property → Verify ownership → Copy verification code
# 2. Bing Webmaster Tools: https://www.bing.com/webmasters
#    - Add site → Verify ownership → Copy verification code
# Paste the code value (without 'content=' prefix)
GOOGLE_SITE_VERIFICATION=your-google-verification-code-here
BING_SITE_VERIFICATION=your-bing-verification-code-here

# ============================================================
# Site Metadata (for SEO and Social Sharing)
# ============================================================
# Your site's primary title (used in meta tags and social sharing)
SITE_NAME=Your Portfolio Name

# Meta description for search engines (optimal 150-160 characters)
# Appears below page title in search results
SITE_DESCRIPTION=Professional portfolio showcasing web development projects, skills, and experience

# Your name or business name (for author meta tag)
SITE_AUTHOR=Your Name

# Comma-separated keywords for search relevance (less critical than description)
SITE_KEYWORDS=portfolio,web developer,full-stack,projects,freelance

# Social media profile URLs (used for Open Graph/social sharing)
# Leave blank if not applicable
SITE_URL=https://yourdomain.com
SOCIAL_TWITTER=https://twitter.com/yourprofile
SOCIAL_GITHUB=https://github.com/yourprofile
SOCIAL_LINKEDIN=https://linkedin.com/in/yourprofile
SOCIAL_INSTAGRAM=https://instagram.com/yourprofile

# ============================================================
# Database Configuration (Optional)
# ============================================================
# Uncomment and set for PostgreSQL or other databases
# DATABASE_URL=postgres://user:password@localhost:5432/dbname
